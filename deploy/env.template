# ============================================================================
#  env.template — file .env untuk server (Oracle Cloud / VPS)
# ============================================================================
#  Salin menjadi `.env` di /opt/academybot, lalu isi tokennya:
#      sudo cp /opt/academybot/deploy/env.template /opt/academybot/.env
#      sudo nano /opt/academybot/.env
#      sudo chown academybot:academybot /opt/academybot/.env
#      sudo chmod 600 /opt/academybot/.env
#
#  WAJIB restart setelah mengedit:
#      sudo systemctl restart academybot
#
#  File ini dibaca oleh systemd sebagai EnvironmentFile, jadi formatnya harus
#  `KEY=VALUE` polos — tanpa tanda kutip, tanpa ekspansi shell, tanpa spasi
#  berlebih di sekitar `=`.
# ============================================================================

# ---------------------------------------------------------------------------
# 1) TOKEN BOT (WAJIB)
# ---------------------------------------------------------------------------
# Token: Discord Developer Portal > Applications > <App> > Bot > Reset Token
# Token hanya bisa ditampilkan SEKALI setelah di-reset.
# Format: <base64>.<base64>.<base64>
#
# PENTING: JANGAN pernah commit file .env ini ke git. Repo ini sudah
# mengabaikannya di .gitignore, tapi tetap lordam file aslinya dari repo
# publik mana pun sebelum menambahkannya ke instance Oracle.
# ---------------------------------------------------------------------------

BOT_1_TOKEN=
BOT_2_TOKEN=
BOT_3_TOKEN=
BOT_4_TOKEN=
BOT_5_TOKEN=
BOT_6_TOKEN=

# ---------------------------------------------------------------------------
# 2) HTTP SERVER
# ---------------------------------------------------------------------------
# Tidak perlu dibuka ke internet (voice Discord itu outbound).
# Binding ke 127.0.0.1 cukup, tapi 0.0.0.0 tidak berbahaya dan memudahkan
# `curl http://localhost:8080/health` dari SSH.
PORT=8080
HOST=127.0.0.1

# ---------------------------------------------------------------------------
# 3) LOGGING
# ---------------------------------------------------------------------------
# journalctl -u academybot -f          -> pretty (enak dibaca manusia)
# journalctl -u academybot -o cat -f   -> json   (enak di-parse, mis. | jq)
LOG_LEVEL=info
LOG_FORMAT=pretty

# Cetak ringkasan seluruh bot setiap N milidetik (0 = nonaktif).
# 3600000 = 1 jam. Berguna saat remote untuk memastikan bot masih di voice.
SUMMARY_INTERVAL_MS=0

# ---------------------------------------------------------------------------
# 4) VOICE
# ---------------------------------------------------------------------------
# Join dalam keadaan mute — menghemat bandwidth.
SELF_MUTE=true
# Join dalam keadaan deaf — bot tidak perlu mendengar apa pun.
SELF_DEAF=true
# DAVE = enkripsi voice end-to-end milik Discord. Biarkan true.
DAVE_ENCRYPTION=true
# Batasi cache discord.js. Tidak perlu untuk 6 bot (diukur: 127 MB tanpa ini,
# 131 MB dengan ini — tidak ada keuntungan), jadi biarkan false.
LIMIT_CACHE=false

# ---------------------------------------------------------------------------
# 5) AUTO-RECONNECT / KEEP-ALIVE
# ---------------------------------------------------------------------------
# 0 = retry selamanya. WAJIB 0 untuk bot AFK — kalau diberi angka, bot akan
# menyerah dan keluar dari loop setelah sejumlah percobaan.
RECONNECT_MAX_ATTEMPTS=0
RECONNECT_INITIAL_DELAY_MS=2000
RECONNECT_MAX_DELAY_MS=60000
RECONNECT_FACTOR=1.8
RECONNECT_JITTER=0.3

# ---------------------------------------------------------------------------
# 6) WATCHDOG
# ---------------------------------------------------------------------------
# Cek berkala "apakah bot benar-benar masih di voice channel?" lalu join ulang
# bila hilang. Ini lapisan pertahanan yang menangkap kegagalan yang tidak
# dilaporkan event Discord.
WATCHDOG_ENABLED=true
WATCHDOG_INTERVAL_MS=30000
# Beri @discordjs/voice kesempatan self-heal dulu sebelum dipaksa rejoin.
VOICE_RECOVERY_GRACE_MS=20000
# Batas waktu menunggu voice connection sampai status Ready.
VOICE_JOIN_TIMEOUT_MS=25000

# ---------------------------------------------------------------------------
# 7) MISC
# ---------------------------------------------------------------------------
# Jarak antar instance saat start (menghindari rate-limit Discord).
STARTUP_STAGGER_MS=1500
# Endpoint /invite menampilkan link OAuth2. true = endpoint terbuka di localhost.
ENABLE_INVITE_ENDPOINT=true
