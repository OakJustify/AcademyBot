# ============================================================================
#  Multi-Bot 24/7 Voice Channel Stay — Environment Variables
#  Salin file ini menjadi `.env` lalu isi nilainya:
#      cp .env.example .env
#  JANGAN PERNAH meng-commit file `.env` (sudah masuk .gitignore).
# ============================================================================

# ---------------------------------------------------------------------------
# 1) HTTP KEEP-ALIVE SERVER (wajib agar bot tidak di-sleep di cloud gratisan)
# ---------------------------------------------------------------------------
# Platform cloud biasanya mengirim PORT secara otomatis. Biarkan kosong bila
# injected oleh platform.
PORT=8080
# 0.0.0.0 wajib di Railway/Render/Fly agar bisa diakses dari luar.
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# 2) LOGGING
# ---------------------------------------------------------------------------
# debug | info | warn | error | silent
LOG_LEVEL=info
# pretty (terlihat di konsol) | json (untuk Railway/Render/Datadog)
LOG_FORMAT=pretty

# Cetak ringkasan seluruh bot setiap N milidetik (0 = nonaktif).
SUMMARY_INTERVAL_MS=0

# ---------------------------------------------------------------------------
# 3) VOICE
# ---------------------------------------------------------------------------
# Join dalam keadaan Mute — menghemat bandwidth.
SELF_MUTE=true
# Join dalam keadaan Deaf — bot tidak perlu mendengar apa pun.
SELF_DEAF=true
# DAVE = enkripsi voice end-to-end milik Discord. Biarkan true.
DAVE_ENCRYPTION=true
# Batasi cache discord.js (berguna saat 50+ bot dalam 1 proses).
LIMIT_CACHE=false

# ---------------------------------------------------------------------------
# 4) AUTO-RECONNECT / KEEP-ALIVE
# ---------------------------------------------------------------------------
# 0 = retry selamanya (paling umum untuk bot AFK).
RECONNECT_MAX_ATTEMPTS=0
RECONNECT_INITIAL_DELAY_MS=2000
RECONNECT_MAX_DELAY_MS=60000
RECONNECT_FACTOR=1.8
RECONNECT_JITTER=0.3

# ---------------------------------------------------------------------------
# 5) WATCHDOG
# ---------------------------------------------------------------------------
# Cek berkala "apakah bot benar-benar masih di VC?" lalu join ulang bila hilang.
WATCHDOG_ENABLED=true
WATCHDOG_INTERVAL_MS=30000
# Waktu tunggu_library @discordjs/voice untuk pulih sendiri sebelum di-paksa rejoin.
VOICE_RECOVERY_GRACE_MS=20000
# Batas waktu menunggu voice connection sampai status Ready.
VOICE_JOIN_TIMEOUT_MS=25000

# ---------------------------------------------------------------------------
# 6) MISC
# ---------------------------------------------------------------------------
# Jarak antar instance saat start (menghindari rate-limit Discord).
STARTUP_STAGGER_MS=1500
# Endpoint /invite (menampilkan link invite OAuth2). false untuk menutupnya.
ENABLE_INVITE_ENDPOINT=true
# Path config alternatif (default: ./config.json)
# CONFIG_FILE=config.production.json

# ============================================================================
#  7) TOKEN BOT  (dipakai config.json lewat "${BOT_1_TOKEN}", dll)
# ============================================================================
# Cara mendapat token:
#   Discord Developer Portal > Applications > <App> > Bot > Reset Token
# Contoh format: <BOT_TOKEN_DISINI>
# PENTING: token hanya bisa ditampilkan SATU KALI setelah di-reset.
# ----------------------------------------------------------------------------

BOT_1_TOKEN=
BOT_2_TOKEN=
BOT_3_TOKEN=
BOT_4_TOKEN=
BOT_5_TOKEN=
BOT_6_TOKEN=

# Voice channel tujuan per bot (dipakai bila Anda memilih menulis
# "vc_id": "${BOT_1_VC_ID}" di dalam config.json).
BOT_1_VC_ID=
BOT_2_VC_ID=
BOT_3_VC_ID=
BOT_4_VC_ID=
BOT_5_VC_ID=
BOT_6_VC_ID=

# ============================================================================
#  Cara menambah bot ke-7, ke-8, ... tanpa menyentuh kode:
#  1) Tambah  BOT_7_TOKEN  di file .env ini
#  2) Tambah  1 objek baru ke array "bots" di config.json
#  3) Restart  ->  `npm start`
#  index.js tidak pernah berubah.
# ============================================================================