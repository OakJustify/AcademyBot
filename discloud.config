{
  "type": "bot",
  "name": "AcademyBot-6x-voice",
  "main": "index.js",
  "start": "npm run start",
  "version": "22",
  "ram": 1024,
  "exclude": [
    "node_modules",
    ".env",
    ".env.*",
    ".git",
    ".gitignore",
    ".github",
    "npm-debug.log",
    "*.log",
    ".DS_Store",
    "LICENSE",
    "deploy/academybot.service",
    "deploy/setup.sh",
    "deploy/update.sh"
  ]
}
